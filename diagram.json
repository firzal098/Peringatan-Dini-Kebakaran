{
  "version": 1,
  "author": "Testarossa's Vanguard - UAD",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -130,
      "left": -220,
      "attrs": { "temperature": "27", "humidity": "68" }
    },
    {
      "type": "wokwi-gas-sensor",
      "id": "mq2",
      "top": 60,
      "left": -230,
      "attrs": { "ppm": "90" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_soil",
      "top": 200,
      "left": -180,
      "attrs": { "value": "520", "label": "Soil Moisture" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_green",
      "top": -90,
      "left": 190,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": -120,
      "left": 259,
      "rotate": 90,
      "attrs": { "color": "green", "label": "NORMAL" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_yellow",
      "top": -10,
      "left": 190,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_yellow",
      "top": -40,
      "left": 259,
      "rotate": 90,
      "attrs": { "color": "#FFD700", "label": "WARNING" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_red",
      "top": 70,
      "left": 190,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": 40,
      "left": 259,
      "rotate": 90,
      "attrs": { "color": "red", "label": "DANGER" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 160,
      "left": 216,
      "attrs": { "volume": "0.4" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3",   "red",   [ "h0" ] ],
    [ "dht1:SDA", "esp:4",     "blue",  [ "h0" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "h0" ] ],

    [ "mq2:VCC", "esp:5V",    "red",    [ "h0" ] ],
    [ "mq2:AO",  "esp:34",    "orange", [ "h0" ] ],
    [ "mq2:GND", "esp:GND.1", "black",  [ "h0" ] ],

    [ "pot_soil:VCC", "esp:3V3",   "red",    [ "h0" ] ],
    [ "pot_soil:SIG", "esp:35",    "purple", [ "h0" ] ],
    [ "pot_soil:GND", "esp:GND.1", "black",  [ "h0" ] ],

    [ "esp:18", "r_green:1",  "green", [ "h0" ] ],
    [ "r_green:2", "led_green:A",  "green", [ "h0" ] ],
    [ "led_green:C", "esp:GND.2", "black",  [ "h0" ] ],

    [ "esp:19", "r_yellow:1", "#FFD700", [ "h0" ] ],
    [ "r_yellow:2", "led_yellow:A", "#FFD700", [ "h0" ] ],
    [ "led_yellow:C", "esp:GND.2", "black", [ "h0" ] ],

    [ "esp:21", "r_red:1",  "red",   [ "h0" ] ],
    [ "r_red:2", "led_red:A",  "red",   [ "h0" ] ],
    [ "led_red:C", "esp:GND.2", "black", [ "h0" ] ],

    [ "esp:22",    "buzzer:2", "red",   [ "h0" ] ],
    [ "buzzer:1",  "esp:GND.2", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
